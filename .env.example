# Variables de entorno de SIVEC
# Copia este archivo como .env y ajusta los valores:  Copy-Item .env.example .env
# Vite lee el .env solo al arrancar: si lo cambias, reinicia `npm run dev`.

# URL base de la API (backend Flask). Sin barra final.
VITE_API_URL=http://localhost:5000/api

# Interruptor de datos:
#   false → API real en VITE_API_URL (el backend debe estar corriendo) — recomendado
#   true  → datos simulados de src/data (no necesita backend, útil para una demo offline)
# Si falta o tiene otro valor, se usa la API real.
VITE_USE_MOCK=false
